node_modules
dist
dist-ssr
*.local
.DS_Store

# tsc build artifacts — both tsconfigs are noEmit; anything matching these
# patterns is stray output from a misconfigured run (see ROADMAP.md gap #1
# writeup, Aug 2026) and safe to delete.
*.tsbuildinfo
scripts/*.js
scripts/*.d.ts
src/**/*.js
src/**/*.d.ts
vite.config.js
vite.config.d.ts

# generated game data (rebuilt from data/players_master.csv via `npm run build:data`)
src/data/generated/

# balance simulator output
sim-results/
*.jsonl

npm-debug.log*
.vscode/*
!.vscode/extensions.json

# disposable scratch/diagnostic scripts (Vitest can't run in the dev sandbox
# this project was built in - see ROADMAP.md - so these stand in for the
# test suite each round, then get left in place rather than deleted; never
# meant to be part of the real commit history)
*.throwaway
*.superseded
# a stray copy of one of the above, saved without the .throwaway suffix by
# mistake and left un-deletable by a sandbox permissions quirk - inert, see
# its own first line
scripts/.verify_tactics_pptx_scratch.ts
